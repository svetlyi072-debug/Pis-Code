%YAML 1.2
---
# GDScript (Godot 4) — syntect's bundled grammars don't include one.
name: GDScript
file_extensions:
  - gd
scope: source.gdscript

variables:
  ident: '[A-Za-z_][A-Za-z0-9_]*'

contexts:
  main:
    - include: comments
    - include: strings
    - include: annotations
    - include: declarations
    - include: keywords
    - include: constants
    - include: numbers
    - include: nodepaths
    - include: types
    - include: functions
    - include: operators

  comments:
    - match: '#.*$'
      scope: comment.line.number-sign.gdscript

  # Prefixes: r"raw", &"StringName", ^"NodePath".
  strings:
    - match: '[rR&^]?"""'
      scope: punctuation.definition.string.begin.gdscript
      push: string_triple_double
    - match: "[rR&^]?'''"
      scope: punctuation.definition.string.begin.gdscript
      push: string_triple_single
    - match: '[rR&^]?"'
      scope: punctuation.definition.string.begin.gdscript
      push: string_double
    - match: "[rR&^]?'"
      scope: punctuation.definition.string.begin.gdscript
      push: string_single

  string_triple_double:
    - meta_scope: string.quoted.double.block.gdscript
    - match: '"""'
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - include: string_content

  string_triple_single:
    - meta_scope: string.quoted.single.block.gdscript
    - match: "'''"
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - include: string_content

  # Single-line strings end at the closing quote, or give up at end of
  # line if it's missing, so one unterminated quote can't swallow the file.
  string_double:
    - meta_scope: string.quoted.double.gdscript
    - match: '"'
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - match: '(?=\n)'
      pop: true
    - include: string_content

  string_single:
    - meta_scope: string.quoted.single.gdscript
    - match: "'"
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - match: '(?=\n)'
      pop: true
    - include: string_content

  string_content:
    - match: '\\(?:[abfnrtv\\"''0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{6}|\n)'
      scope: constant.character.escape.gdscript
    - match: '%[-+ #0]*[0-9]*(?:\.[0-9]+)?[sdfxXoecv%]'
      scope: constant.other.placeholder.gdscript

  annotations:
    - match: '@{{ident}}'
      scope: storage.type.annotation.gdscript

  declarations:
    - match: '\b(func)\s+({{ident}})'
      captures:
        1: storage.type.function.gdscript
        2: entity.name.function.gdscript
    - match: '\b(class_name|class)\s+({{ident}})'
      captures:
        1: storage.type.class.gdscript
        2: entity.name.class.gdscript
    - match: '\b(signal)\s+({{ident}})'
      captures:
        1: storage.type.signal.gdscript
        2: entity.name.function.signal.gdscript
    # Bare `func` is a lambda: `func(x): ...`.
    - match: '\b(?:func|extends|enum|var|const|static)\b'
      scope: storage.type.gdscript

  keywords:
    - match: '(?<!\.)\b(?:if|elif|else|for|while|match|break|continue|pass|return|await|yield|assert|breakpoint|when)\b'
      scope: keyword.control.gdscript
    - match: '(?<!\.)\b(?:and|or|not|in|is|as)\b'
      scope: keyword.operator.word.gdscript
    - match: '\b(?:self|super)\b'
      scope: variable.language.gdscript
    - match: '\bvoid\b'
      scope: storage.type.gdscript

  constants:
    - match: '\b(?:true|false|null|PI|TAU|INF|NAN)\b'
      scope: constant.language.gdscript

  numbers:
    - match: '\b0[xX][0-9a-fA-F_]+\b'
      scope: constant.numeric.integer.hexadecimal.gdscript
    - match: '\b0[bB][01_]+\b'
      scope: constant.numeric.integer.binary.gdscript
    - match: '(?<![\w.])(?:[0-9][0-9_]*\.[0-9][0-9_]*|\.[0-9][0-9_]*)(?:[eE][+-]?[0-9]+)?|\b[0-9][0-9_]*[eE][+-]?[0-9]+\b'
      scope: constant.numeric.float.gdscript
    - match: '\b[0-9][0-9_]*\b'
      scope: constant.numeric.integer.decimal.gdscript

  # $Child/Path, %UniqueName, and the `$` in $"Quoted/Path".
  nodepaths:
    - match: '[$%]{{ident}}(?:/{{ident}})*'
      scope: variable.other.nodepath.gdscript
    - match: '\$(?=["''])'
      scope: variable.other.nodepath.gdscript

  # Heuristics: UPPER_SNAKE is a constant/enum value, PascalCase is a
  # class/type (Vector2, Node2D, Input), lowercase int/float/bool are
  # built-in types.
  types:
    - match: '\b[A-Z][A-Z0-9_]+\b'
      scope: constant.other.gdscript
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: support.class.gdscript
    - match: '\b(?:int|float|bool)\b'
      scope: storage.type.primitive.gdscript

  functions:
    - match: '\b{{ident}}(?=\s*\()'
      scope: variable.function.gdscript

  operators:
    - match: '->|:=|\*\*=?|<<=?|>>=?|[-+*/%&|^~<>=!]=?'
      scope: keyword.operator.gdscript
